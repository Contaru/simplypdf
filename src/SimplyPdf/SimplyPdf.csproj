<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SimplyPdf</RootNamespace>
    <AssemblyName>SimplyPdf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>SimplyPdf</PackageId>
    <!-- Released by tagging vX.Y.Z (release.yml checks the tag matches this value). -->
    <Version>0.3.0</Version>
    <Description>Dependency-free PDF writer for .NET, made for invoices, receipts and other business documents: absolute-position drawing, the 14 standard fonts, embedded TrueType fonts with any character they hold, PNG/JPEG images, a table that continues on the next page, links, attachments and PDF/A-3b. No native binaries, no third-party packages.</Description>
    <PackageReleaseNotes>New: paragraphs that mix fonts, sizes and colours (TextRun); text placed by its baseline, and font ascent and descent; fixed line height; table cells with their own style and column span; clickable links; QR codes and other module matrices drawn from their modules; attachments; PDF/A-3b output.
Changed: embedded TrueType fonts are written as composite fonts and draw any character they have a glyph for. Characters outside Latin-1 that used to come out as "?" now show their glyph, or the font's .notdef when it has none.
Fixed: Scale, Rotate and Transform keep six decimals of the matrix instead of three.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Contaru/simplypdf</PackageProjectUrl>
    <PackageTags>pdf;pdf-generation;invoice;pdfa;dependency-free</PackageTags>
    <!-- Source Link: consumers step into this code from the repository at the tagged commit. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="SimplyPdf.Tests" />
  </ItemGroup>

</Project>
